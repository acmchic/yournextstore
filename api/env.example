


MOCKUP_ASSET_ROOT=./public
MOCKUP_CACHE_DIR=./.cache/mockups
MOCKUP_DEFAULT_WIDTH=1200
MOCKUP_MAX_WIDTH=2400
MOCKUP_DEFAULT_FORMAT=webp
MOCKUP_WEBP_QUALITY=94
GEARMENT_IMPORT_LIMIT=40
MOCKUP_JPEG_QUALITY=90

# Stripe Checkout. Keep both key pairs here and switch with STRIPE_MODE.
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Send a private Telegram alert when checkout creates a paid order.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mailtrap transactional email for customer order confirmations.
EMAIL_SUPPORT=help@teebravo.com
EMAIL_SUPPORT_NAME=TeeBravo
MAILTRAP_API_KEY=

X-Gearment-Client-Key=XCx57QB1VOXCD2
X-Gearment-Client-Secret=HHKdZG8dhHUx5GyexpkTXXlhOvlcjTGUydo6ZQ5CXsUpqUv3SyGgy7K2qBdWDdZh

# Public storefront origin. Checkout redirects derive from this when overrides are blank.
STOREFRONT_PUBLIC_URL=https://teebravo.com
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
