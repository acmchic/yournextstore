# Store-owned FastAPI service. Server-only; never expose credentials to browsers.
STORE_API_URL=http://localhost:8000
POD_MOCKUP_API_URL=http://localhost:8000
NEXT_PUBLIC_URL=https://teebravo.com
STOREFRONT_PUBLIC_URL=https://teebravo.com
# Pinterest website claim verification token; server-side metadata only.
PINTEREST_DOMAIN_VERIFY=
# Enable only after payment, policies, product rights and public HTTPS images are verified.
MERCHANT_FEED_ENABLED=false
# Hosted Stripe Checkout; keep keys server-only and use test keys in development.
# Direct `uvicorn` runs load these values from `api/.env`; root Docker Compose loads this file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave empty to derive checkout redirects from STOREFRONT_PUBLIC_URL.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
STRIPE_AUTOMATIC_TAX=false
