# Non-secret production deployment map. Keep this file safe to commit.
TEEBRAVO_PUBLIC_DOMAIN=teebravo.com
TEEBRAVO_ADMIN_DOMAIN=admin.teebravo.com
TEEBRAVO_API_DOMAIN=api.teebravo.com
TEEBRAVO_CERT_NAME=teebravo.com
TEEBRAVO_STOREFRONT_PORT=1990
TEEBRAVO_API_PORT=1991
TEEBRAVO_COMPOSE_PROJECT=teebravo-prod
# Docker bind-mount root. Keep this under /home when Docker is installed as a Snap.
TEEBRAVO_SHARED_DIR=/srv/teebravo/shared
# Docker bind-mounted env files. Keep this under /home when Docker is installed as a Snap.
TEEBRAVO_DOCKER_CONFIG_DIR=/etc/teebravo

# Original images: read-only bind mount shared by Admin and API; no copying.
TEEBRAVO_IMAGE_SOURCE=/home/images_ids/images
