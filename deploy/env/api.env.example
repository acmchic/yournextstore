DB_HOST=db
DB_PORT=3306
DB_NAME=pod_store
DB_USER=teebravo
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_POOL_RECYCLE=1800
MOCKUP_ASSET_ROOT=/app/api/public
MOCKUP_CACHE_DIR=/app/api/.cache/mockups
MOCKUP_ALLOW_UNSIGNED_URLS=false
MOCKUP_URL_SECRET=REPLACE_WITH_RANDOM_SECRET
STOREFRONT_PUBLIC_URL=https://__PUBLIC_DOMAIN__
CHECKOUT_SUCCESS_URL=https://__PUBLIC_DOMAIN__/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://__PUBLIC_DOMAIN__/checkout?error=cancel
# Checkout secrets stay in this API-only env file. Use a matching pair from the
# same Stripe mode: sk_test_* with its test-mode webhook signing secret, or
# sk_live_* with that live endpoint's signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
