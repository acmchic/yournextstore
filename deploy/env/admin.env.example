APP_NAME=TeeBravo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__ADMIN_DOMAIN__
INERTIA_SSR_ENABLED=false
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pod_store
DB_USERNAME=teebravo
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=teebravo_admin_session
SESSION_DOMAIN=__ADMIN_DOMAIN__
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Configure real SMTP before using password reset / email verification.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=support@__PUBLIC_DOMAIN__
MAIL_FROM_NAME=TeeBravo
