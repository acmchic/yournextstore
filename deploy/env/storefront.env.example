# Shell-compatible KEY=value; no substitutions/commands. Read by bash and systemd.
STORE_API_URL=http://127.0.0.1:__API_PORT__
POD_MOCKUP_API_URL=http://127.0.0.1:__API_PORT__
STORE_MEDIA_URL=https://__API_DOMAIN__
NEXT_PUBLIC_URL=https://__PUBLIC_DOMAIN__
STOREFRONT_PUBLIC_URL=https://__PUBLIC_DOMAIN__
# Optional Pinterest website-claim verification token; emitted in server metadata.
PINTEREST_DOMAIN_VERIFY=
MERCHANT_FEED_ENABLED=false
BUILD_HEAP_MB=2048
# Generate once: openssl rand -base64 32. Keep stable between builds.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_KEY
